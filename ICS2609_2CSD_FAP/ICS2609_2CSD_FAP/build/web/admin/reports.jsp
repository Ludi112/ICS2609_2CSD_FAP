<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%
    javax.servlet.http.HttpSession sess = request.getSession(false);
    if (sess == null || sess.getAttribute("username") == null
            || !"Admin".equalsIgnoreCase((String) sess.getAttribute("role"))) {
        response.sendRedirect(request.getContextPath() + "/login.jsp");
        return;
    }
    String username = (String) sess.getAttribute("username");
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generate Reports | Active Learning, Inc.</title>
    <link rel="stylesheet" href="<%= request.getContextPath() %>/style.css">
</head>
<body>
    <header class="top-bar">
        <span class="brand">Active Learning, Inc.</span>
        <span class="page-label">Generate Reports</span>
    </header>
    <%@ include file="/includes/navbar_admin.jsp" %>
    <div class="page-content">
        <h2 class="page-title">Generate Reports</h2>
        <div class="summary-grid">
            <div class="summary-card">
                <h3>Total Reports</h3>
                <div class="summary-value">0</div>
                <div class="summary-sub">Generated this session</div>
            </div>
            <div class="summary-card">
                <h3>Last Generated</h3>
                <div class="summary-value" style="font-size:1.2rem;">—</div>
                <div class="summary-sub">No reports yet</div>
            </div>
        </div>
        <div class="card">
            <h3 style="color:var(--primary);margin-bottom:16px;">Report Options</h3>
            <div class="quick-actions">
                <a href="#">All Users Report</a>
                <a href="#">Enrollment Report</a>
                <a href="#">Audit Log Report</a>
            </div>
            <div class="info-message" style="margin-top:16px;">
                PDF report generation will be available once connected to the reporting module.
            </div>
        </div>
        <div class="card">
            <h3 style="color:var(--primary);margin-bottom:16px;">Report History</h3>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Report Type</th>
                            <th>Generated By</th>
                            <th>Date</th>
                            <th>File</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" style="text-align:center;color:var(--text-muted);padding:24px;">
                                No reports generated yet.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>