<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>ICS2609_2CSD_FAP</display-name>

<context-param>
<param-name>derby.driver</param-name>
<param-value>org.apache.derby.jdbc.EmbeddedDriver</param-value>
</context-param>
<context-param>
<param-name>derby.url</param-name>
<param-value>jdbc:derby:lms_auth_db;create=true</param-value>
</context-param>

<context-param>
<param-name>derby.username</param-name>
<param-value/>
</context-param>
<context-param>
<param-name>derby.password</param-name>
<param-value/>
</context-param>
         
<context-param>
<param-name>mysql.driver</param-name>
<param-value>com.mysql.cj.jdbc.Driver</param-value>
</context-param>
<context-param>
<param-name>mysql.url</param-name>
<param-value>jdbc:mysql://localhost:3306/lms_business_db?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true</param-value>
</context-param>
<context-param>
<param-name>mysql.username</param-name>
<param-value>root</param-value>
</context-param>
<context-param>
<param-name>mysql.password</param-name>
<param-value>Sandoq123</param-value>
</context-param>

<context-param>
<param-name>pg.driver</param-name>
<param-value>org.postgresql.Driver</param-value>
</context-param>
<context-param>
<param-name>pg.url</param-name>
<param-value>jdbc:postgresql://localhost:5432/lms_logs_db</param-value>
</context-param>
<context-param>
<param-name>pg.username</param-name>
<param-value>postgres</param-value>
</context-param>
<context-param>
<param-name>pg.password</param-name>
<param-value>1234</param-value>
</context-param>

<context-param>
<param-name>pdf.header</param-name>
<param-value>Active Learning, Inc. — Course Management System</param-value>
</context-param>
<context-param>
<param-name>pdf.footer</param-name>
<param-value>Generated by Active Learning, Inc. System | Confidential</param-value>
</context-param>

<welcome-file-list>
<welcome-file>index.jsp</welcome-file>
</welcome-file-list>

<filter>
<filter-name>AuthFilter</filter-name>
<filter-class>filter.AuthFilter</filter-class>
</filter>
<filter-mapping>
<filter-name>AuthFilter</filter-name>
<url-pattern>/*</url-pattern>
</filter-mapping>

<!--  Login Servlet  -->
<servlet>
<servlet-name>LoginServlet</servlet-name>
<servlet-class>Servlets.LoginServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>LoginServlet</servlet-name>
<url-pattern>/LoginServlet</url-pattern>
</servlet-mapping>
<!--  Logout Servlet  -->
<servlet>
<servlet-name>LogoutServlet</servlet-name>
<servlet-class>Servlets.LogoutServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>LogoutServlet</servlet-name>
<url-pattern>/LogoutServlet</url-pattern>
</servlet-mapping>
<!--  CAPTCHA Servlet  -->
<servlet>
<servlet-name>CaptchaServlet</servlet-name>
<servlet-class>Servlets.CaptchaServlet</servlet-class>
</servlet>
<servlet-mapping>
<servlet-name>CaptchaServlet</servlet-name>
<url-pattern>/CaptchaServlet</url-pattern>
</servlet-mapping>

<error-page>
<error-code>400</error-code>
<location>/errors/error404.jsp</location>
</error-page>
<error-page>
<error-code>403</error-code>
<location>/errors/error403.jsp</location>
</error-page>
<error-page>
<error-code>404</error-code>
<location>/errors/error404.jsp</location>
</error-page>
<error-page>
<error-code>500</error-code>
<location>/errors/error500.jsp</location>
</error-page>
<error-page>
<exception-type>java.lang.Exception</exception-type>
<location>/errors/error500.jsp</location>
</error-page>
<!--  ══════════════════════════════════════════════════════════════════
         SESSION TIMEOUT — 30 minutes (FR-AUTH-006)
    ══════════════════════════════════════════════════════════════════  -->
<session-config>
<session-timeout>30</session-timeout>
</session-config>
</web-app>
